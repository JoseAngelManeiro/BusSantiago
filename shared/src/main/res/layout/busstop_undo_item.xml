<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:minHeight="56dp"
  android:orientation="horizontal"
  android:paddingStart="@dimen/default_padding"
  android:paddingEnd="@dimen/default_padding"
  android:paddingTop="@dimen/extra_small_padding"
  android:paddingBottom="@dimen/extra_small_padding"
  android:gravity="center_vertical"
  android:background="@color/last_updated_bg">

  <TextView
    android:id="@+id/undoMessageTextView"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:textSize="15sp"
    android:textColor="@color/last_updated_text"
    android:text="@string/favorite_stop_removed"
    tools:text="Parada eliminada de favoritos" />

  <TextView
    android:id="@+id/undoButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:text="@string/undo"
    android:textSize="15sp"
    android:textStyle="bold"
    android:textColor="@color/colorAccent"
    android:background="?attr/selectableItemBackground"
    android:textAllCaps="true"
    tools:text="DESHACER" />

</LinearLayout>
